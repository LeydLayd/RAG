# URL del backend FastAPI para producción (ej. https://api-rag.tudominio.com)
# En Vercel puedes definir BACKEND_URL para que las peticiones se redirijan mediante el proxy /api
BACKEND_URL=http://127.0.0.1:8000

# Opcional: Si deseas que el navegador llame directamente al backend
# NEXT_PUBLIC_API_URL=https://api-rag.tudominio.com
